#!/bin/bash

# omarchy:summary=Apply the current theme color to Chromium, Chrome, Edge, and Brave
# omarchy:hidden=true

# The Chromium colour policy is a machine-wide, root-owned file, so the write
# itself lives in omarchy-theme-set-browser-policy. What is needed here is only
# the colour, and that helper ships with the install/ tree -- a component that is
# not part of every deployment, and is absent from this one, where the bare
# `source` left both names below undefined. An empty colour was then handed to
# the policy writer, which rejects it, and every theme switch reported a failure
# whether or not a Chromium browser was even installed.
#
# So the helper is used when it is there, and the two values it provides are
# defined locally when it is not. Same contract, same values, no dependency on a
# tree this script cannot assume exists.
if [[ -f $OMARCHY_PATH/install/helpers/browser-policy.sh ]]; then
  source "$OMARCHY_PATH/install/helpers/browser-policy.sh"
else
  # Matches install/helpers/browser-policy.sh. Kept in step with it.
  BROWSER_POLICY_DEFAULT_COLOR="#1c2027"

  # The theme payload is a decimal "r,g,b" triple, as rendered into
  # chromium.theme. Anything else falls back to the default rather than
  # producing a colour nobody asked for.
  browser_policy_theme_hex() {
    local theme_rgb=$1

    if [[ $theme_rgb =~ ^[[:space:]]*([0-9]{1,3})[[:space:]]*,[[:space:]]*([0-9]{1,3})[[:space:]]*,[[:space:]]*([0-9]{1,3})[[:space:]]*$ ]] &&
      (( 10#${BASH_REMATCH[1]} < 256 && 10#${BASH_REMATCH[2]} < 256 && 10#${BASH_REMATCH[3]} < 256 )); then
      printf '#%02x%02x%02x' "$((10#${BASH_REMATCH[1]}))" "$((10#${BASH_REMATCH[2]}))" "$((10#${BASH_REMATCH[3]}))"
      return
    fi

    printf '%s' "$BROWSER_POLICY_DEFAULT_COLOR"
  }
fi

CHROMIUM_THEME=$HOME/.local/state/omarchy/current/theme/chromium.theme
THEME_HEX_COLOR=$BROWSER_POLICY_DEFAULT_COLOR

if [[ -f $CHROMIUM_THEME ]]; then
  THEME_HEX_COLOR=$(browser_policy_theme_hex "$(<$CHROMIUM_THEME)")
fi

refresh_running_browser() {
  local process="$1"
  local command="$2"
  local pgrep_args="${3:--x}"

  if omarchy-cmd-present "$command" && pgrep $pgrep_args "$process" >/dev/null; then
    "$command" --refresh-platform-policy --no-startup-window &>/dev/null
  fi
}

# Writing the policy needs root, and on a machine with no Chromium-family browser
# there is nothing to write it for. The policy writer re-execs through sudo or
# pkexec, so running it regardless would either prompt for a password in the
# middle of a theme switch or fail the step over a browser that is not
# installed. Each directory is checked here for the same reason the writer checks
# it before creating one: handing a browser a managed-policy root it does not
# otherwise have is not this step's call.
policy_dir_exists=0
for dir in /etc/chromium/policies/managed \
  /etc/opt/chrome/policies/managed \
  /etc/opt/edge/policies/managed \
  /etc/brave/policies/managed; do
  if [[ -d $dir && ! -L $dir ]]; then
    policy_dir_exists=1
    break
  fi
done

failed=0
if (( policy_dir_exists )); then
  omarchy-theme-set-browser-policy "${THEME_HEX_COLOR#\#}" || failed=1

  refresh_running_browser chromium chromium
  refresh_running_browser chrome google-chrome-stable
  refresh_running_browser msedge microsoft-edge-stable
  refresh_running_browser brave brave-browser
fi

exit "$failed"
