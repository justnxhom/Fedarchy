#!/bin/bash

# omarchy:summary=Set the system monospace font
# omarchy:args=<font-name>
# omarchy:examples=omarchy font list | omarchy font set "CaskaydiaMono Nerd Font"

set -uo pipefail

usage() {
  echo "Usage: omarchy-font-set <font-name>"
}

font_name="${1:-}"

case "$font_name" in
  -h | --help)
    usage
    exit 0
    ;;
  "")
    usage >&2
    exit 1
    ;;
esac

font_name="${font_name#"${font_name%%[![:space:]]*}"}"
font_name="${font_name%"${font_name##*[![:space:]]}"}"

if [[ -z $font_name ]]; then
  usage >&2
  exit 1
fi

if [[ $font_name == *:* || $font_name == *,* || $font_name == *[[:cntrl:]]* ]]; then
  echo "Font '$font_name' cannot be written to a terminal config: control characters, ':' and ',' are not representable" >&2
  exit 1
fi

# Serialize concurrent font switches. Rapid menu clicks otherwise race
# non-atomic config rewrites and pile up fc-cache / shell FileView storms.
lock_path="${XDG_RUNTIME_DIR:-/tmp}/omarchy-font-set.lock"
if ! exec {lock_fd}>"$lock_path"; then
  echo "Could not take the font switch lock: $lock_path" >&2
  exit 1
fi
flock "$lock_fd" || exit 1

font_family_exists() {
  local family

  while IFS= read -r family; do
    family="${family//\"/}"
    family="${family#"${family%%[![:space:]]*}"}"
    family="${family%"${family##*[![:space:]]}"}"
     [[ -n $family && $family == "$font_name" ]] && return 0

  done < <(fc-list --format='%{family}\n' 2>/dev/null | tr ',' '\n')

  return 1
}

if ! font_family_exists; then
  echo "Font '$font_name' not found."
  exit 1
fi

xml_escape() {
  local value="$1"

  value=${value//&/&amp;}
  value=${value//</&lt;}
  value=${value//>/&gt;}
  value=${value//\"/&quot;}
  value=${value//\'/&apos;}
  printf '%s' "$value"
}

quoted_escape() {
  local value="$1"

  value=${value//\\/\\\\}
  value=${value//\"/\\\"}
  printf '%s' "$value"
}

write_in_place() {
  local file="$1"
  local source="$2"

  cat "$source" >"$file"
}

replace_matching_lines() {
  local file="$1"
  local pattern="$2"
  local replacement="$3"
  local fallback="$4"
  local tmp

  [[ -f $file ]] || return 1
  tmp=$(mktemp "${TMPDIR:-/tmp}/omarchy-font.XXXXXX") || return 1

  if ! FONT_PATTERN="$pattern" FONT_REPLACEMENT="$replacement" FONT_FALLBACK="$fallback" awk '
    BEGIN {
      pattern = ENVIRON["FONT_PATTERN"]
      replacement = ENVIRON["FONT_REPLACEMENT"]
      fallback = ENVIRON["FONT_FALLBACK"]
    }
    $0 ~ pattern { print replacement; found = 1; next }
    { print }
    END { if (!found && fallback != "") print fallback }
  ' "$file" >"$tmp"; then
    rm -f "$tmp"
    return 1
  fi

  if ! write_in_place "$file" "$tmp"; then
    rm -f "$tmp"
    return 1
  fi

  rm -f "$tmp"
}

append_lines() {
  local file="$1"
  local content="$2"
  local tmp

  tmp=$(mktemp "${TMPDIR:-/tmp}/omarchy-font.XXXXXX") || return 1
  printf '%s\n' "$content" >"$tmp" || { rm -f "$tmp"; return 1; }

  if ! write_in_place "$file" "$tmp"; then
    rm -f "$tmp"
    return 1
  fi

  rm -f "$tmp"
}

set_alacritty_family() {
  local file="$1"
  local value="$2"
  local tmp

  [[ -f $file ]] || return 1
  tmp=$(mktemp "${TMPDIR:-/tmp}/omarchy-font.XXXXXX") || return 1

  if ! ALACRITTY_FAMILY="$value" awk '
    BEGIN { replacement = "family = \"" ENVIRON["ALACRITTY_FAMILY"] "\"" }
    /family[[:space:]]*=[[:space:]]*"[^"]*"/ {
      print replacement
      found = 1
      next
    }
    { print }
    END { if (!found) pending = 1 }
  ' "$file" >"$tmp"; then
    rm -f "$tmp"
    return 1
  fi

  if ! write_in_place "$file" "$tmp"; then
    rm -f "$tmp"
    return 1
  fi
  rm -f "$tmp"

  if grep -qE 'family[[:space:]]*=' "$file"; then
    return 0
  fi

  if grep -qE '^[[:space:]]*\[font\.normal\]' "$file"; then
    ALACRITTY_FAMILY="$value" awk '
      { print }
      /^[[:space:]]*\[font\.normal\][[:space:]]*$/ && !inserted {
        print "family = \"" ENVIRON["ALACRITTY_FAMILY"] "\""
        inserted = 1
      }
    ' "$file" >"$tmp" || { rm -f "$tmp"; return 1; }
    write_in_place "$file" "$tmp" || { rm -f "$tmp"; return 1; }
    rm -f "$tmp"
    return 0
  fi

  append_lines "$file" "
[font.normal]
family = \"$value\""
}

font_warnings=()

escaped_font="$(quoted_escape "$font_name")"
alacritty_config="$HOME/.config/alacritty/alacritty.toml"
if [[ -f $alacritty_config ]]; then
  set_alacritty_family "$alacritty_config" "$escaped_font" || font_warnings+=("alacritty.toml")
fi

kitty_config="$HOME/.config/kitty/kitty.conf"
if [[ -f $kitty_config ]] || omarchy-cmd-present kitty; then
  mkdir -p "$HOME/.config/kitty"
  : >>"$kitty_config"
  replace_matching_lines "$kitty_config" '^[[:space:]]*font_family[[:space:]]+' \
    "font_family \"$escaped_font\"" "font_family \"$escaped_font\"" || font_warnings+=("kitty.conf")
fi

ghostty_config="$HOME/.config/ghostty/config"
if [[ -f $ghostty_config ]]; then
  replace_matching_lines "$ghostty_config" '^[[:space:]]*font-family[[:space:]]*=' \
    "font-family = \"$escaped_font\"" "font-family = \"$escaped_font\"" || font_warnings+=("ghostty/config")
fi

foot_config="$HOME/.config/foot/foot.ini"
if [[ -f $foot_config ]]; then
  if grep -qE '^[[:space:]]*font[[:space:]]*=' "$foot_config"; then
    replace_matching_lines "$foot_config" '^[[:space:]]*font[[:space:]]*=' \
      "font=$font_name:size=9" "" || font_warnings+=("foot.ini")
  else
    font_warnings+=("foot.ini")
  fi
fi

# fontconfig is the canonical source of truth — the omarchy shell, Qt apps,
# and anything resolving "monospace" all read from here. This file is loaded
# after the package-owned default, and prepend_first puts the chosen family at
# the head of the list so it wins over the family that default prefers.
# Write via temp+rename so the shell's FileView never sees a torn file.
fontconfig_file="$HOME/.config/fontconfig/fonts.conf"
if ! mkdir -p "$(dirname "$fontconfig_file")"; then
  font_warnings+=("fontconfig")
elif ! fontconfig_tmp=$(mktemp "${fontconfig_file}.XXXXXX"); then
  font_warnings+=("fontconfig")
else
  escaped_font_xml="$(xml_escape "$font_name")"
  if ! cat >"$fontconfig_tmp" <<XML
<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "fonts.dtd">
<fontconfig>
  <match target="pattern">
    <test name="family" qual="any">
      <string>monospace</string>
    </test>
    <edit name="family" mode="prepend_first" binding="strong">
      <string>$escaped_font_xml</string>
    </edit>
  </match>
</fontconfig>
XML
  then
    font_warnings+=("fontconfig")
  elif ! mv -f "$fontconfig_tmp" "$fontconfig_file"; then
    font_warnings+=("fontconfig")
  fi
  rm -f "$fontconfig_tmp"
fi

# Update the fontconfig cache so fc-match resolves the new font immediately.
fc-cache -f 2>/dev/null || true

if ! fc-match monospace -f '%{family}\n' 2>/dev/null | head -n1 | grep -Fqi -- "$font_name"; then
  font_warnings+=("fontconfig did not resolve '$font_name' as monospace")
fi

# The shell watches fonts.conf and re-resolves the family on change — no
# reloadConfig (which only re-parses shell.json) and never a full restart. The
# terminals are signalled only now, once every config they read is on disk.
if (( ${#font_warnings[@]} > 0 )); then
  printf 'Font "%s" was set, but these were not updated: %s\n' "$font_name" "${font_warnings[*]}" >&2
fi

if pgrep -x kitty >/dev/null; then
  pkill -USR1 -x kitty || font_warnings+=("kitty reload signal")
fi

if pgrep -x ghostty >/dev/null; then
  pkill -SIGUSR2 -x ghostty || font_warnings+=("ghostty reload signal")
  omarchy-notification-send -g "You must restart Ghostty to see font change"
fi

if pgrep -x foot >/dev/null; then
  omarchy-notification-send -g "You must restart Foot to see font change"
fi

omarchy-hook font-set "$font_name" || font_warnings+=("omarchy-hook font-set")

if (( ${#font_warnings[@]} > 0 )); then
  exit 1
fi
