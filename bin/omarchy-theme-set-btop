#!/bin/bash
# Install the theme for btop.
#
# btop picks its theme from a `theme =` key in btop.conf naming a file in its
# themes directory, and has no include directive: the key has to live in the
# user's own btop.conf. Only that one key is added, so every other setting in
# the file is left exactly as it was, and an existing key is replaced rather than
# duplicated. The running btop is then told to re-read its configuration.
set -euo pipefail

THEME_DIR="$HOME/.local/state/omarchy/current/theme"
GENERATED="$THEME_DIR/btop.theme"
CONFIG_DIR="$HOME/.config/btop"
CONFIG="$CONFIG_DIR/btop.conf"
THEME_NAME="omarchy"
THEMES_DIR="$CONFIG_DIR/themes"

[[ -f $GENERATED ]] || exit 0

mkdir -p "$THEMES_DIR"
# Written through a temporary file in the same directory and then renamed,
# because a plain copy truncates the target first: anything reading it at that
# moment -- a running btop reading the file -- would see half a file. A rename
# within one filesystem is atomic, so a reader sees either the old file or the
# new one.
install_atomically() {
  local source="$1" target="$2" tmp
  tmp="$(mktemp "${target}.XXXXXX")"
  if cat "$source" >"$tmp"; then
    chmod --reference="$target" "$tmp" 2>/dev/null || chmod 644 "$tmp"
    mv -f "$tmp" "$target"
  else
    rm -f "$tmp"
    return 1
  fi
}
install_atomically "$GENERATED" "$THEMES_DIR/$THEME_NAME.theme"

if [[ ! -f $CONFIG ]]; then
  {
    printf '# Generated by omarchy: only the theme key is managed here.\n'
    printf 'theme = "themes/%s.theme"\n' "$THEME_NAME"
  } >"$CONFIG"
else
  # Rewrite the key in place, or append it when the user has none. Commented-out
  # mentions are left alone: a commented line is not a setting.
  if grep -qE '^[[:space:]]*theme[[:space:]]*=' "$CONFIG"; then
    sed -i -E "s|^[[:space:]]*theme[[:space:]]*=.*$|theme = \"themes/$THEME_NAME.theme\"|" "$CONFIG"
  else
    printf '\n# Added by omarchy so btop follows the theme.\ntheme = "themes/%s.theme"\n' \
      "$THEME_NAME" >>"$CONFIG"
  fi
fi

# btop re-reads its configuration on this signal; a running one is the only
# reason to send it, so it is not an error when there is none.
pkill -SIGUSR2 -x btop 2>/dev/null || true

printf 'btop theme installed: %s\n' "$THEMES_DIR/$THEME_NAME.theme"
