#!/bin/bash

# omarchy:summary=Launch the Omarchy shell with its log kept in the journal
# omarchy:hidden=true

export OMARCHY_PATH="${OMARCHY_PATH:-$HOME/Fedarchy}"

SHELL_CONFIG="${OMARCHY_PATH%/}/shell"
SHELL_RUNTIME_DIR="${OMARCHY_SHELL_RUNTIME_DIR:-${XDG_RUNTIME_DIR:-/run/user/$UID}/omarchy-shell}"
LAUNCHER_LOCK="${SHELL_RUNTIME_DIR}/launcher.lock"
LAUNCHER_PID="${SHELL_RUNTIME_DIR}/launcher.pid"

LOG_TAG=omarchy-shell
MAX_RELAUNCHES=5
RELAUNCH_WINDOW=60

log() {
  logger -t "$LOG_TAG" "$*"
}

fail() {
  printf '%s\n' "$*" >&2
  log "$*"
}

if ! command -v quickshell >/dev/null 2>&1; then
  fail "quickshell is not installed; cannot start the Fedarchy shell."
  exit 127
fi

for dependency in flock timeout; do
  if ! command -v "$dependency" >/dev/null 2>&1; then
    fail "$dependency is not installed; cannot supervise the Fedarchy shell."
    exit 127
  fi
done

if [[ ! -f ${SHELL_CONFIG}/shell.qml ]]; then
  fail "Fedarchy shell config not found: ${SHELL_CONFIG}/shell.qml"
  exit 78
fi

if ! mkdir -p "$SHELL_RUNTIME_DIR"; then
  fail "Cannot create the Fedarchy shell runtime directory: ${SHELL_RUNTIME_DIR}"
  exit 73
fi

exec 9>"$LAUNCHER_LOCK" || {
  fail "Cannot open the Fedarchy shell launcher lock: ${LAUNCHER_LOCK}"
  exit 73
}

if ! flock -n 9; then
  message="Another Fedarchy shell launcher already supervises ${SHELL_CONFIG}; not starting a second one."
  printf '%s\n' "$message" >&2
  log "$message"
  exit 0
fi

printf '%s\n' "$$" >"$LAUNCHER_PID"

forget_pid() {
  if [[ -f $LAUNCHER_PID ]] && [[ $(cat "$LAUNCHER_PID" 2>/dev/null) == "$$" ]]; then
    rm -f "$LAUNCHER_PID"
  fi

  return 0
}
trap forget_pid EXIT

while timeout 5 quickshell kill -p "$SHELL_CONFIG" --any-display >/dev/null 2>&1; do :; done

JOURNAL_AVAILABLE=0
command -v systemd-cat >/dev/null 2>&1 && JOURNAL_AVAILABLE=1

# Quickshell only logs to its instance runtime dir (tmpfs), so when the shell
# dies the idle/lock event trail is gone after a reboot. The journal keeps it
# across sessions, bounded and timestamped, under the omarchy-shell tag.
#
# Backgrounded because bash defers a trap until a foreground command returns but
# interrupts wait. systemd-cat execs, so the job is Quickshell itself.
#
# Quickshell's own reloading is off; Omarchy restarts the shell deliberately.
# A package upgrade rewriting $OMARCHY_PATH/shell would otherwise reload it
# against a half-written tree, and that failed reload leaves a second engine
# generation behind that turns the next restart's IPC kill into a crash.
run_shell() {
  if (( JOURNAL_AVAILABLE )); then
    QS_DISABLE_FILE_WATCHER=1 QS_NO_RELOAD_POPUP=1 \
      systemd-cat -t "$LOG_TAG" -- quickshell -n -p "$SHELL_CONFIG" 9>&- &
  else
    QS_DISABLE_FILE_WATCHER=1 QS_NO_RELOAD_POPUP=1 \
      quickshell -n -p "$SHELL_CONFIG" 9>&- &
  fi

  shell_pid=$!

  local status

  while true; do
    wait "$shell_pid"
    status=$?

    # An interrupted wait and a shell killed by that signal report alike.
    kill -0 "$shell_pid" 2>/dev/null || break
  done

  shell_pid=""
  return $status
}

# A compositor busy reconfiguring outputs can miss a query without being gone,
# and that is when the shell dies.
compositor_alive() {
  local attempt

  for attempt in 1 2 3; do
    hyprctl -j monitors >/dev/null 2>&1 && return 0
    (( attempt < 3 )) && sleep 0.5
  done

  return 1
}

terminating=0
shell_pid=""

stop() {
  terminating=1
  [[ -n $shell_pid ]] && kill -TERM "$shell_pid" 2>/dev/null
  return 0
}
trap stop HUP INT TERM

attempts=0
window_started=$SECONDS

while true; do
  # A signal during the backoff only reaches the trap once the sleep is over.
  (( terminating )) && exit 0

  run_shell
  status=$?

  (( terminating )) && exit 0
  (( status == 0 )) && exit 0

  # Relaunching into a session already tearing down burns the attempt budget.
  if ! compositor_alive; then
    log "Omarchy shell exited with status $status and the compositor is gone; not relaunching."
    exit 0
  fi

  if (( SECONDS - window_started > RELAUNCH_WINDOW )); then
    attempts=0
    window_started=$SECONDS
  fi

  if (( ++attempts > MAX_RELAUNCHES )); then
    log "Giving up on the Fedarchy shell after $attempts relaunches in under a minute."
    exit 1
  fi

  log "Omarchy shell exited with status $status; relaunching."
  sleep 1
done