#!/bin/bash

# omarchy:summary=Toggle microphone mute. Drives the hardware mic-mute LED on laptops that expose one.

# A mute key is a single decision. A second argument would ask for a second
# toggle in one invocation, and the old code ignored it while reporting the
# first toggle as the whole result.
(( $# == 0 )) || {
  echo "Usage: omarchy-audio-input-mute" >&2
  exit 1
}

# Both the toggle and the readback have to succeed before any OSD or LED claim.
# Showing "Microphone on" after a toggle that never landed is the worst outcome
# here: the user is then talking into a muted microphone while the display
# insists it is live.
if ! timeout 2 wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle >/dev/null 2>&1; then
  echo "Could not toggle microphone mute." >&2
  exit 1
fi

state="$(timeout 2 wpctl get-volume @DEFAULT_AUDIO_SOURCE@ 2>/dev/null || true)"
muted=""

if [[ -n $state ]]; then
  if [[ $state == *MUTED* ]]; then
    muted=true
  else
    muted=false
  fi
else
  case "$(timeout 2 pactl get-source-mute @DEFAULT_AUDIO_SOURCE@ 2>/dev/null | awk 'NR == 1 {print $NF; exit}')" in
    yes) muted=true ;;
    no) muted=false ;;
  esac
fi

if [[ -z $muted ]]; then
  echo "Could not read the microphone state after toggling it." >&2
  exit 1
fi

if [[ $muted == "true" ]]; then
  omarchy-brightness-keyboard-mute on
  omarchy-osd -i microphone-muted -m "Microphone muted"
  status=$?
else
  omarchy-brightness-keyboard-mute off
  omarchy-osd -i microphone -m "Microphone on"
  status=$?
fi

exit $status
