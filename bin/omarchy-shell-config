#!/bin/bash
set -o pipefail

CONFIG_FILE="$HOME/.config/omarchy/shell.json"
DEFAULTS_FILE="$OMARCHY_PATH/config/omarchy/shell.json"

fail() {
  echo "${0##*/}: $*" >&2
  exit 1
}

refresh_shell_config() {
  if ! omarchy-shell shell reloadConfig >/dev/null 2>&1; then
    omarchy-shell -q shell rescanPlugins >/dev/null 2>&1 || true
  fi
}

source_file() {
  if [[ -s $CONFIG_FILE ]]; then
    printf '%s\n' "$CONFIG_FILE"
  else
    printf '%s\n' "$DEFAULTS_FILE"
  fi
}

NORMALIZE='
  def object_or_empty: if type == "object" then . else {} end;
  def array_or_empty: if type == "array" then . else [] end;
  object_or_empty
  | .version = 1
  | .bar = (.bar | object_or_empty)
  | .bar.layout = (.bar.layout | object_or_empty)
  | .bar.layout.left = (.bar.layout.left | array_or_empty)
  | .bar.layout.center = (.bar.layout.center | array_or_empty)
  | .bar.layout.right = (.bar.layout.right | array_or_empty)
  | .plugins = (.plugins | array_or_empty)
'

_SHELL_CONFIG_TMP=""
_SHELL_CONFIG_LOCK_FD=""
_SHELL_CONFIG_LOCK_DIR=""
cleanup_shell_config_tmp() {
  if [[ -n $_SHELL_CONFIG_TMP ]]; then rm -f "$_SHELL_CONFIG_TMP"; fi
  if [[ -n $_SHELL_CONFIG_LOCK_DIR ]]; then rmdir "$_SHELL_CONFIG_LOCK_DIR" 2>/dev/null || true; fi
  if [[ -n $_SHELL_CONFIG_LOCK_FD ]]; then exec {_SHELL_CONFIG_LOCK_FD}>&- 2>/dev/null || true; fi
}
trap cleanup_shell_config_tmp EXIT

commit() {
  local program="$1"
  shift
  local config_dir lock_file
  config_dir=$(dirname "$CONFIG_FILE")
  mkdir -p "$config_dir"
  lock_file="$CONFIG_FILE.lock"
  if command -v flock >/dev/null 2>&1; then
    exec {_SHELL_CONFIG_LOCK_FD}>"$lock_file"
    flock -x "$_SHELL_CONFIG_LOCK_FD" || fail "could not lock shell config"
  else
    _SHELL_CONFIG_LOCK_DIR="$CONFIG_FILE.lock.d"
    local attempt
    local attempt
    for attempt in {1..100}; do
      if mkdir "$_SHELL_CONFIG_LOCK_DIR" 2>/dev/null; then break; fi
      [[ $attempt == 100 ]] && fail "could not lock shell config"
      sleep 0.05
    done
  fi
  _SHELL_CONFIG_TMP=$(mktemp "$config_dir/.shell.json.XXXXXX")
  jq -S -e "$@" "$program" "$(source_file)" >"$_SHELL_CONFIG_TMP" \
    || fail "could not update shell config"
  if [[ -f $CONFIG_FILE && ! -e $CONFIG_FILE.bak ]]; then
    cp -p -- "$CONFIG_FILE" "$CONFIG_FILE.bak"
  fi
  mv -f -- "$_SHELL_CONFIG_TMP" "$CONFIG_FILE"
  _SHELL_CONFIG_TMP=""
  if [[ -n $_SHELL_CONFIG_LOCK_DIR ]]; then rmdir "$_SHELL_CONFIG_LOCK_DIR" 2>/dev/null || true; fi
  if [[ -n $_SHELL_CONFIG_LOCK_FD ]]; then exec {_SHELL_CONFIG_LOCK_FD}>&-; fi
  refresh_shell_config
}
