#!/bin/bash

# omarchy:summary=Set the current background image or video
# omarchy:args=<path-to-media>
# omarchy:examples=omarchy theme bg set ~/Pictures/background.png

if [[ -z ${1:-} ]]; then
  echo "Usage: omarchy-theme-bg-set <path-to-media>" >&2
  exit 1
fi

CURRENT_BACKGROUND_LINK="$HOME/.local/state/omarchy/current/background"

# Resolve only after the request names something that is really there. realpath
# reports nothing for a path that does not exist, and an empty target would be
# linked in place of the wallpaper that is currently on show.
if [[ ! -e $1 ]]; then
  echo "File does not exist: $1" >&2
  exit 1
fi

BACKGROUND="$(realpath "$1")"

if [[ -z $BACKGROUND || ! -f $BACKGROUND ]]; then
  echo "Not a readable file: $1" >&2
  exit 1
fi

# Create symlink to the new background media
if ! ln -nsf "$BACKGROUND" "$CURRENT_BACKGROUND_LINK"; then
  echo "Could not link the current background to $BACKGROUND" >&2
  exit 1
fi

# A link that does not resolve is a wallpaper the shell cannot load, so the
# selection is refused rather than left pointing at nothing.
if [[ ! -f $CURRENT_BACKGROUND_LINK ]]; then
  echo "The background link does not resolve to a file: $CURRENT_BACKGROUND_LINK" >&2
  exit 1
fi

# Update the live shell background immediately when it is running. The
# background plugin also polls this symlink, but IPC avoids the visible delay.
omarchy-shell -q background set "$BACKGROUND"
