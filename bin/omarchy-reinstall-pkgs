#!/bin/bash

# omarchy:summary=Reinstall all default Fedarchy packages from the stable channel
# omarchy:requires-sudo=true

set -euo pipefail

OMARCHY_PATH="${OMARCHY_PATH:-/usr/share/omarchy}"
manifest="$OMARCHY_PATH/install/omarchy-base.packages"

[[ -f $manifest && -r $manifest ]] || {
  echo "Package manifest not found: $manifest" >&2
  exit 1
}

packages=()
while IFS= read -r line || [[ -n $line ]]; do
  line=${line%%#*}
  read -r -a fields <<<"$line"
  [[ ${#fields[@]} -eq 0 ]] && continue
  [[ ${#fields[@]} -eq 1 && ${fields[0]} =~ ^[A-Za-z0-9+_.@:%-]+$ ]] || {
    echo "Invalid package manifest entry: $line" >&2
    exit 1
  }
  packages+=("${fields[0]}")
done < "$manifest"

(( ${#packages[@]} > 0 )) || {
  echo "Package manifest contains no packages: $manifest" >&2
  exit 1
}

omarchy-update-dnf distro-sync -y
omarchy-update-dnf install -y --skip-broken "${packages[@]}"
