#!/bin/bash

# omarchy:summary=Show current monospace font
# omarchy:examples=omarchy font current

# fontconfig is the source of truth. fc-match returns a comma-separated
# alias list (e.g. "JetBrainsMono Nerd Font,JetBrainsMono NF") so take
# the first entry.
current="$(fc-match monospace -f '%{family}\n' 2>/dev/null | head -n1 | cut -d, -f1)"
current="${current#"${current%%[![:space:]]*}"}"
current="${current%"${current##*[![:space:]]}"}"

if [[ -z $current ]]; then
  echo "Unknown" >&2
  exit 1
fi

printf '%s\n' "$current"
