#!/bin/bash

# omarchy:summary=Set the default audio output and move active streams
# omarchy:args=<node-id> <sink-name>
# omarchy:examples=omarchy audio output set default 42 alsa_output.pci-0000_00_1f.3.analog-stereo

node_id=${1:-}
sink_name=${2:-}

usage() {
  echo "Usage: omarchy-audio-output-set-default <node-id> <sink-name>" >&2
}

if [[ -z $node_id || -z $sink_name ]]; then
  usage
  exit 1
fi

(( $# == 2 )) || {
  usage
  exit 1
}

# A node id is a PulseAudio index and a sink name is a wire-format identifier.
# Passing either through unvalidated is how a value beginning with a dash turns
# into an option for pactl instead of an argument, and a newline in the name
# splits one sink into two arguments.
[[ $node_id =~ ^[0-9]+$ ]] || {
  echo "Invalid audio node id: $node_id" >&2
  exit 1
}

[[ $sink_name != -* && $sink_name != *[[:space:]]* ]] || {
  echo "Invalid audio sink name: $sink_name" >&2
  exit 1
}

if ! timeout 2 wpctl set-default "$node_id" 2>/dev/null; then
  echo "Could not set the default output node $node_id." >&2
  exit 1
fi

if ! timeout 2 pactl set-default-sink "$sink_name" 2>/dev/null; then
  echo "Could not set the default sink $sink_name." >&2
  exit 1
fi

# Move only real application streams. A DSP filter-chain's own output is also a
# sink input but carries no application.name, and moving it would rewire the
# processing itself -- onto headphones, or into its own virtual sink, which is a
# cycle. EasyEffects' output stream must stay put for the same reason.
# A stream can also vanish between listing and moving it, so an individual
# failure is reported but does not undo the default switch that already landed.
inputs=()
while read -r input; do
  [[ $input =~ ^[0-9]+$ ]] || continue
  inputs+=("$input")
done < <(timeout 2 pactl list sink-inputs 2>/dev/null | awk '
  /^Sink Input #/ {id = substr($3, 2)}
  /application\.name = / {
    app = $0
    sub(/.*application\.name = "/, "", app)
    sub(/"$/, "", app)
    if (app != "EasyEffects" && id != "") print id
  }')

move_failed=0
for input in "${inputs[@]}"; do
  if ! timeout 2 pactl move-sink-input "$input" "$sink_name" 2>/dev/null; then
    ((move_failed++))
    echo "Could not move stream $input to $sink_name." >&2
  fi
done

if ((move_failed > 0)); then
  echo "Default output is now $sink_name but ${move_failed} stream(s) stayed on the previous output." >&2
fi

exit 0
