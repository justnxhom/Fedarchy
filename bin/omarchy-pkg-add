#!/bin/bash

# omarchy:summary=Install Fedora packages if they are missing
# omarchy:args=<packages...>
# omarchy:examples=omarchy pkg add jq ripgrep
# omarchy:requires-sudo=true

set -euo pipefail

(( $# > 0 )) || {
  echo "Usage: omarchy-pkg-add <packages...>" >&2
  exit 1
}

if ! omarchy-update-lock held; then
  exec omarchy-update-lock run-wait "$0" "$@"
fi

if omarchy-pkg-missing "$@"; then
  if (( EUID == 0 )); then
    dnf5 install -y "$@" || exit 1
  else
    sudo dnf5 install -y "$@" || exit 1
  fi
fi

for pkg in "$@"; do
  if ! rpm -q "$pkg" &>/dev/null; then
    echo -e "\033[31mError: Package '$pkg' did not install\033[0m" >&2
    exit 1
  fi
done

exit 0
