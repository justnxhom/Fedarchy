#!/bin/bash

# omarchy:summary=Disable a COPR repository (keeps the .repo file)
# omarchy:args=<owner/name>
# omarchy:requires-sudo=true

set -euo pipefail

usage() { echo "Usage: omarchy-copr-disable <owner/name>"; }
fail() { echo "Error: $*" >&2; exit 1; }

(( $# == 1 )) || { usage; exit 1; }

repo="$1"
[[ $repo == */* ]] || fail "COPR must be in owner/name form (got: $repo)"

source omarchy-sudo-keepalive 2>/dev/null || true
  # -y: these are invoked from submenus and scripts, where there is nobody to
  # answer a confirmation prompt. copr-add already passed it; match it here so
  # enabling, disabling and removing cannot block waiting for a keystroke.
omarchy-update-lock run-wait sudo dnf5 copr disable -y "$repo"
echo "Disabled COPR: $repo"
