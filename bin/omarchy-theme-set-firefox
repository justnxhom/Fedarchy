#!/bin/bash
# Install the theme for Firefox.
#
# Firefox keeps its configuration in a profile, and the profile's location moved
# to the XDG directory, so a step that looks only at ~/.mozilla/firefox finds
# nothing on a current install and reports success. Both locations are tried here.
#
# The theme is delivered as userChrome.css and userContent.css in the profile's
# chrome directory, and there are three ways that can look like it worked while
# doing nothing:
#
#   Firefox ignores userChrome.css entirely unless
#   toolkit.legacyUserProfileCustomizations.stylesheets is true, and it is false
#   by default.
#
#   The base theme is whatever the Add-ons Manager last had selected, and a
#   coloured theme reimplements the same custom properties. Left alone, the
#   palette lands on the tokens that theme happens not to set and the browser
#   comes out half themed, so the built-in default is pinned.
#
#   The new tab page is a content page, so it needs userContent.css as well.
#
# A stylesheet the user wrote by hand is theirs: their rules are kept, the
# generated part lives in a marked block that is replaced in place, and the
# original is backed up once.
set -euo pipefail

THEME_DIR="$HOME/.local/state/omarchy/current/theme"
CHROME_SRC="$THEME_DIR/firefox-userchrome.css"
CONTENT_SRC="$THEME_DIR/firefox-usercontent.css"
COLORS_FILE="$THEME_DIR/colors.toml"

[[ -f $CHROME_SRC || -f $CONTENT_SRC ]] || exit 0

# The profile directory, from whichever of the two locations has a profiles.ini.
# `Default=` names it relative to the firefox directory; older files give an
# absolute path under Path= instead.
find_profile() {
  local ini base default relative

  for ini in "$HOME/.config/mozilla/firefox/profiles.ini" "$HOME/.mozilla/firefox/profiles.ini"; do
    [[ -f $ini ]] || continue
    base="$(dirname "$ini")"

    # `Default=` means two different things in this file. In an [Install...] section
    # it names the profile to use; in a [ProfileN] section it is the boolean "this
    # is the default profile", written as 1. Matching the first one regardless picks
    # up that 1 and themes the wrong directory -- silently, because every step then
    # succeeds against a profile nobody is looking at. So the value has to be one
    # that could be a path.
    default=$(awk -F= '
      /^[[:space:]]*Default[[:space:]]*=/ {
        value = $2
        gsub(/^[ \t]+|[ \t]+$/, "", value)
        if (value != "" && value != "0" && value != "1") { print value; exit }
      }
    ' "$ini")

    if [[ -n $default ]]; then
      relative=${default#Profiles/}
      if [[ $relative == /* ]]; then
        printf '%s\n' "$relative"
        return 0
      fi
      if [[ -d $base/$relative ]]; then
        printf '%s\n' "$base/$relative"
        return 0
      fi
    fi

    # No install section: fall back to whichever profile is flagged as default.
    relative=$(awk -F= '
      /^[[:space:]]*\[Profile[0-9]+\][[:space:]]*$/ { in_profile = 1; path = ""; next }
      /^[[:space:]]*\[/ { in_profile = 0 }
      in_profile && /^[[:space:]]*Path[[:space:]]*=/ {
        path = $2; gsub(/^[ \t]+|[ \t]+$/, "", path)
      }
      in_profile && /^[[:space:]]*Default[[:space:]]*=[[:space:]]*1[[:space:]]*$/ { print path; exit }
    ' "$ini")

    if [[ -z $relative ]]; then
      relative=$(awk -F= '/^[[:space:]]*Path[[:space:]]*=/ { gsub(/^[ \t]+|[ \t]+$/, "", $2); print $2; exit }' "$ini")
    fi

    if [[ -n $relative ]]; then
      if [[ $relative == /* ]]; then
        printf '%s\n' "$relative"
        return 0
      fi
      if [[ -d $base/$relative ]]; then
        printf '%s\n' "$base/$relative"
        return 0
      fi
    fi
  done

  return 1
}

if ! PROFILE=$(find_profile); then
  # Not an error. Firefox has simply never been run on this machine, and a theme
  # switch should not fail over it. Said out loud, because silence here is what
  # made this look broken for so long.
  echo "firefox: no profile found, nothing themed (has firefox been run yet?)"
  exit 0
fi

CHROME_DIR="$PROFILE/chrome"
USER_JS="$PROFILE/user.js"
mkdir -p "$CHROME_DIR"

mode=dark
if [[ -f $COLORS_FILE ]]; then
  mode=$(omarchy-theme-color --file "$COLORS_FILE" mode)
fi
if [[ $mode == light ]]; then
  system_uses_dark=false
else
  system_uses_dark=true
fi

# --- prefs -------------------------------------------------------------------

# The prefs without which the stylesheets are inert. They live in a marked block
# that is replaced in place on every switch, so a re-run cannot stack duplicates
# and the user can see which lines are not theirs. Anything outside the block in
# user.js is left exactly as it was.
PREF_BEGIN='// Managed by omarchy-theme-set-firefox - rewritten on every theme switch, do not edit'
# Worded so the marker phrase above appears exactly once in the file, which is
# also how the block is found.
PREF_END='// End of Fedarchy managed prefs'

write_prefs() {
  local block tmp

  [[ -f $USER_JS ]] || : >"$USER_JS"

  block="$(mktemp "${USER_JS}.block.XXXXXX")"
  {
    printf '%s\n' "$PREF_BEGIN"
    printf 'user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);\n'
    printf 'user_pref("extensions.activeThemeID", "default-theme@mozilla.org");\n'
    printf 'user_pref("ui.systemUsesDarkTheme", %s);\n' "$system_uses_dark"
    printf '%s\n' "$PREF_END"
  } >"$block"

  rm -f "${USER_JS}".??????
  tmp="$(mktemp "${USER_JS}.XXXXXX")"

  if grep -qF "$PREF_BEGIN" "$USER_JS"; then
    awk -v begin="$PREF_BEGIN" -v end="$PREF_END" -v block="$block" '
      index($0, begin) == 1 { skipping = 1; while ((getline line < block) > 0) print line; close(block); next }
      index($0, end) == 1 { skipping = 0; next }
      !skipping { print }
    ' "$USER_JS" >"$tmp"
  else
    cat "$USER_JS" >"$tmp"
    # A newline first: a file with no trailing newline would otherwise have the
    # marker glued onto its last pref, commenting it out.
    if [[ $(tail -c 1 "$tmp" | wc -l) -eq 0 ]]; then
      printf '\n' >>"$tmp"
    fi
    cat "$block" >>"$tmp"
  fi

  rm -f "$block"
  chmod --reference="$USER_JS" "$tmp" 2>/dev/null || chmod 644 "$tmp"
  mv -f "$tmp" "$USER_JS"
}

write_prefs

# --- stylesheets -------------------------------------------------------------

BEGIN_MARK='/* >>> Fedarchy theme: managed block >>> */'
# Deliberately worded so the phrase "Fedarchy theme: managed block" appears only
# in the opening marker: the block is located by searching for it, and a marker
# at each end containing the phrase would make every search ambiguous.
END_MARK='/* <<< end of Fedarchy managed theme >>> */'

# The markers written by the previous version of this step. They are recognised so
# that their block is removed rather than kept: an earlier release wrote a
# different pair of markers, so a file written by it ends up with the old block
# followed by the new one, and the stale half keeps a set of !important
# declarations of its own. Same precedence, so the newest wins and the page still
# looks right -- which is why this went unnoticed, while the file carried two
# copies of everything.
LEGACY_BEGIN_MARK='/* --- Fedarchy theme: managed block, rewritten on every theme change --- */'
LEGACY_END_MARK='/* --- end Fedarchy managed block --- */'

# Merge the generated sheet into the user's, keeping the rules they wrote and
# discarding any managed block -- current or legacy -- so exactly one remains.
#
# A target that is a symlink is written through rather than replaced. This desktop
# links the profile's stylesheet into the shared theme cache, and renaming a
# temporary file onto a symlink swaps the link for a regular file -- which ends
# the arrangement and quietly breaks whatever else reads that path.
install_sheet() {
  local source="$1" target="$2" real tmp

  [[ -f $source ]] || return 0

  if [[ -L $target ]]; then
    real=$(readlink -f "$target") || return 0
  else
    real="$target"
  fi

  # The first time, keep whatever was there: it is hand-written until the theme
  # pipeline takes it over, and losing it silently would be the worst outcome.
  if [[ -f $real && ! -f $real.omarchy-backup ]]; then
    cp "$real" "$real.omarchy-backup"
  fi

  rm -f "${real}".??????
  tmp="$(mktemp "${real}.XXXXXX")"

  # The user's own rules are whatever survives both block formats. Written in one
  # pass rather than appended to the file as it stands, because that is what would
  # otherwise preserve the old block's contents inside the new one.
  if [[ -f $real ]]; then
    awk -v b1="$BEGIN_MARK" -v e1="$END_MARK" \
        -v b2="$LEGACY_BEGIN_MARK" -v e2="$LEGACY_END_MARK" '
      index($0, b1) == 1 { skip = 1; next }
      index($0, b2) == 1 { skip = 1; next }
      index($0, e1) == 1 { skip = 0; next }
      index($0, e2) == 1 { skip = 0; next }
      !skip { print }
    ' "$real" >"$tmp"
  fi

  if [[ $(tail -c 1 "$tmp" | wc -l) -eq 0 ]]; then
    printf '\n' >>"$tmp"
  fi
  printf '%s\n' "$BEGIN_MARK" >>"$tmp"
  cat "$source" >>"$tmp"
  printf '%s\n' "$END_MARK" >>"$tmp"

  chmod --reference="$real" "$tmp" 2>/dev/null || chmod 644 "$tmp"
  mv -f "$tmp" "$real"
}

install_sheet "$CHROME_SRC" "$CHROME_DIR/userChrome.css"
install_sheet "$CONTENT_SRC" "$CHROME_DIR/userContent.css"

printf 'firefox theme installed: %s\n' "$PROFILE"
