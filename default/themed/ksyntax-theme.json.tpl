{
  "metadata": {
    "copyright": [
      "SPDX-FileCopyrightText: Generated by Fedarchy. Palette from the active Omarchy theme."
    ],
    "license": "SPDX-License-Identifier: MIT",
    "name": "Fedarchy",
    "revision": 1
  },
  "editor-colors": {
    "BackgroundColor": "{{ background }}",
    "BracketMatching": "{{ mix background foreground 25% }}",
    "CodeFolding": "{{ muted }}",
    "CurrentLine": "{{ mix background lighter_background 45% }}",
    "CurrentLineNumber": "{{ accent }}",
    "IconBorder": "{{ background }}",
    "IndentationLine": "{{ mix background foreground 8% }}",
    "LineNumbers": "{{ muted }}",
    "MarkBookmark": "{{ mix background orange 22% }}",
    "MarkBreakpointActive": "{{ mix background red 22% }}",
    "MarkBreakpointDisabled": "{{ mix background muted 22% }}",
    "MarkBreakpointReached": "{{ mix background green 22% }}",
    "MarkError": "{{ mix background red 22% }}",
    "MarkExecution": "{{ accent }}",
    "MarkWarning": "{{ mix background yellow 22% }}",
    "ModifiedLines": "{{ mix background yellow 18% }}",
    "ReplaceHighlight": "{{ mix background orange 30% }}",
    "SavedLines": "{{ mix background green 18% }}",
    "SearchHighlight": "{{ mix background yellow 28% }}",
    "Separator": "{{ muted }}",
    "SpellChecking": "{{ red }}",
    "TabMarker": "{{ muted }}",
    "TemplateBackground": "{{ mix background foreground 6% }}",
    "TemplateFocusedPlaceholder": "{{ mix background accent 16% }}",
    "TemplatePlaceholder": "{{ mix background foreground 10% }}",
    "TemplateReadOnlyPlaceholder": "{{ mix background red 14% }}",
    "TextSelection": "{{ selection }}",
    "WordWrapMarker": "{{ mix background foreground 20% }}"
  },
  "text-styles": {
    "Alert": {
      "background-color": "{{ mix background red 22% }}",
      "bold": "true",
      "selected-text-color": "{{ foreground }}",
      "text-color": "{{ red }}"
    },
    "Annotation": {
      "selected-text-color": "{{ foreground }}",
      "text-color": "{{ green }}"
    },
    "Attribute": {
      "selected-text-color": "{{ foreground }}",
      "text-color": "{{ blue }}"
    },
    "BaseN": {
      "selected-text-color": "{{ foreground }}",
      "text-color": "{{ orange }}"
    },
    "BuiltIn": {
      "selected-text-color": "{{ foreground }}",
      "text-color": "{{ magenta }}"
    },
    "Char": {
      "selected-text-color": "{{ foreground }}",
      "text-color": "{{ green }}"
    },
    "Comment": {
      "italic": "true",
      "selected-text-color": "{{ foreground }}",
      "text-color": "{{ muted }}"
    },
    "CommentVar": {
      "italic": "true",
      "selected-text-color": "{{ foreground }}",
      "text-color": "{{ mix muted foreground 40% }}"
    },
    "Constant": {
      "bold": "true",
      "selected-text-color": "{{ foreground }}",
      "text-color": "{{ orange }}"
    },
    "ControlFlow": {
      "bold": "true",
      "selected-text-color": "{{ foreground }}",
      "text-color": "{{ accent }}"
    },
    "DataType": {
      "selected-text-color": "{{ foreground }}",
      "text-color": "{{ yellow }}"
    },
    "DecVal": {
      "selected-text-color": "{{ foreground }}",
      "text-color": "{{ orange }}"
    },
    "Documentation": {
      "italic": "true",
      "selected-text-color": "{{ foreground }}",
      "text-color": "{{ mix muted foreground 30% }}"
    },
    "Error": {
      "selected-text-color": "{{ foreground }}",
      "text-color": "{{ red }}",
      "underline": "true"
    },
    "Extension": {
      "bold": "true",
      "selected-text-color": "{{ foreground }}",
      "text-color": "{{ blue }}"
    },
    "Float": {
      "selected-text-color": "{{ foreground }}",
      "text-color": "{{ orange }}"
    },
    "Function": {
      "selected-text-color": "{{ foreground }}",
      "text-color": "{{ blue }}"
    },
    "Import": {
      "selected-text-color": "{{ foreground }}",
      "text-color": "{{ cyan }}"
    },
    "Information": {
      "selected-text-color": "{{ foreground }}",
      "text-color": "{{ cyan }}"
    },
    "Keyword": {
      "bold": "true",
      "selected-text-color": "{{ foreground }}",
      "text-color": "{{ accent }}"
    },
    "Normal": {
      "selected-text-color": "{{ foreground }}",
      "text-color": "{{ foreground }}"
    },
    "Operator": {
      "selected-text-color": "{{ foreground }}",
      "text-color": "{{ cyan }}"
    },
    "Others": {
      "selected-text-color": "{{ foreground }}",
      "text-color": "{{ green }}"
    },
    "Preprocessor": {
      "selected-text-color": "{{ foreground }}",
      "text-color": "{{ cyan }}"
    },
    "RegionMarker": {
      "background-color": "{{ mix background magenta 14% }}",
      "selected-text-color": "{{ foreground }}",
      "text-color": "{{ magenta }}"
    },
    "SpecialChar": {
      "selected-text-color": "{{ foreground }}",
      "text-color": "{{ cyan }}"
    },
    "SpecialString": {
      "selected-text-color": "{{ foreground }}",
      "text-color": "{{ green }}"
    },
    "String": {
      "selected-text-color": "{{ foreground }}",
      "text-color": "{{ green }}"
    },
    "Variable": {
      "selected-text-color": "{{ foreground }}",
      "text-color": "{{ foreground }}"
    },
    "VerbatimString": {
      "selected-text-color": "{{ foreground }}",
      "text-color": "{{ green }}"
    },
    "Warning": {
      "selected-text-color": "{{ foreground }}",
      "text-color": "{{ yellow }}"
    }
  },
  "custom-styles": {}
}
